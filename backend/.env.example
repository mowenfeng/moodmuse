MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_USE_MOCK=true
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=music-2.6
MINIMAX_TIMEOUT_S=120
MINIMAX_POLL_INTERVAL_S=3
MINIMAX_HTTP_TIMEOUT_S=300
MINIMAX_OUTPUT_FORMAT=url
MINIMAX_AUDIO_SAMPLE_RATE=44100
MINIMAX_AUDIO_BITRATE=256000
MINIMAX_AUDIO_FORMAT=mp3

# AI 翻唱第二步（/v1/music_generation）使用的 model，默认 music-cover-free。
# 若接口返回 2061「token plan not support model, music-cover-free」，请改为账号支持的模型名（常见试 music-cover），保存后重启后端。
MINIMAX_COVER_GENERATE_MODEL=music-cover-free
